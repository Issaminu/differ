{
  "name": "differ",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "VITE_TARGET=web tsc --noEmit && VITE_TARGET=web vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/icons/app-icon-1024.png && cp src-tauri/icons/128x128@2x.png public/app-icon.png",
    "bench": "node bench/diff.bench.ts",
    "bench:flame": "node bench/profile.ts",
    "bench:analyze": "node bench/analyze.ts",
    "bench:validate": "node bench/validate.ts",
    "bench:build-wasm": "wasm-pack build crates/diff-wasm --target nodejs --release --out-dir pkg-node && wasm-pack build crates/diff-wasm --target bundler --release --out-dir pkg-bundler"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@preact/signals-core": "^1.14.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide": "^1.11.0",
    "simple-icons": "^16.17.0"
  },
  "devDependencies": {
    "@codemirror/merge": "^6.12.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.6.0",
    "tinybench": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "wasm-pack": "^0.14.0"
  },
  "trustedDependencies": [
    "wasm-pack"
  ]
}
